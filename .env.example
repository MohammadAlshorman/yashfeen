# ─────────────────────────────────────────────────────────────
# Yashfeen — environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file or share its contents.
# ─────────────────────────────────────────────────────────────

# Node environment — keep "production" on the live server
NODE_ENV=production

# Port the app listens on (most hosts inject PORT automatically;
# the app always honours process.env.PORT and binds 0.0.0.0)
PORT=3000

# MySQL connection string — create the database + user in your
# hosting panel (Hostinger: Databases → MySQL; cPanel: MySQL Databases)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# Administrator login for the CMS at /admin
# Choose a strong, unique password. These are NEVER hard-coded anywhere.
# If the value contains a "#" or spaces, wrap it in double quotes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign admin session cookies (HS256 JWT).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=
